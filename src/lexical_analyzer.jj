options {
    IGNORE_CASE = true;
}

PARSER_BEGIN(lexical_analyzer)
import java.io.*;
public class lexical_analyzer {

    public static PrintWriter gramWriter;
    public static void main(String[] args) throws ParseException, IOException {
        if (args.length != 1) {
            System.err.println("Uso: java lexical_analyzer <arquivo.pas>");
            System.exit(1);
        }
        String inputPath = args[0];
        String base = new File(inputPath).getName().replaceFirst("\\.pas$", "");
        File outDir = new File("outputs");
        if (!outDir.exists()) outDir.mkdirs();
        gramWriter = new PrintWriter(new FileWriter(new File(outDir, base + ".gram")));
        
        // inicializa o parser lendo do arquivo de entrada
        lexical_analyzer parser = new lexical_analyzer(new FileInputStream(inputPath));
        parser.Start();          // roda o Start()
        gramWriter.close();      // fecha o arquivo de saída
     }

    private static String getTokenName(int kind) {
        java.lang.reflect.Field[] fields = lexical_analyzerConstants.class.getFields();
        for (java.lang.reflect.Field field : fields) {
            try {
                if (field.getType() == int.class && field.getInt(null) == kind) {
                    return field.getName();
                }
            } catch (IllegalAccessException e) {
                e.printStackTrace();
            }
        }
        return "UNKNOWN_TOKEN";
    }

}
PARSER_END(lexical_analyzer)

/* For the regular expressions on the right, the token on the left will be returned: */

TOKEN : {
//Turbo Pascal reserved words
    //Control Keywords
    < KW_IF: "if" >
    | < KW_THEN: "then" >
    | < KW_ELSE: "else" >
    | < KW_BEGIN: "begin" >
    | < KW_END: "end" >
    | < KW_CASE: "case" >
    | < KW_REPEAT: "repeat" >
    | < KW_UNTIL: "until" >
    | < KW_WHILE: "while" >
    | < KW_FOR: "for" >
    | < KW_TO: "to" >
    | < KW_DOWNTO: "downto" >
    | < KW_DO: "do" >

    //Statements
    | < KW_PROGRAM: "program" >
    | < KW_VAR: "var" >
    | < KW_CONST: "const" >
    | < KW_TYPE: "type" >
    | < KW_FUNCTION: "function" >
    | < KW_PROCEDURE: "procedure" >
    | < KW_UNIT: "unit" >
    | < KW_USES: "uses" >

    //Boolean/mathematical operations and operators
    | < KW_DIV: "div" >
    | < KW_MOD: "mod" >
    | < KW_AND: "and" >
    | < KW_OR: "or" >
    | < KW_NOT: "not" >
    | < KW_XOR: "xor" >
    | < KW_SHL: "shl" >
    | < KW_SHR: "shr" >

//Object Pascal reserved words
    | < KW_AS: "as" >
    | < KW_CLASS: "class" >
    | < KW_DISPINTERFACE: "dispinterface" >
    | < KW_EXCEPT: "except" >
    | < KW_EXPORTS: "exports" >
    | < KW_FINALIZATION: "finalization" >
    | < KW_FINALLY: "finally" >
    | < KW_INITIALIZATION: "initialization" >
    | < KW_INLINE: "inline" >
    | < KW_IS: "is" >
    | < KW_LIBRARY: "library" >
    | < KW_ON: "on" >
    | < KW_OUT: "out" >
    | < KW_PACKED: "packed" >
    | < KW_PROPERTY: "property" >
    | < KW_RAISE: "raise" >
    | < KW_RESOURCESTRING: "resourcestring" >
    | < KW_THREADVAR: "threadvar" >
    | < KW_TRY: "try" >

//Label
    | < KW_LABEL: "label" >

//Modifies (DOCS: They are not exactly reserved words in the sense that they can be used as identifiers, but in specific places)
//for this work they are treated as reserved words for simplicity
    | < KW_ABSOLUTE: "absolute" >
    | < KW_ABSTRACT: "abstract" >
    | < KW_ALIAS: "alias" >
    | < KW_ASSEMBLER: "assembler" >
    | < KW_BITPACKED: "bitpacked" >
    | < KW_BREAK: "break" >
    | < KW_CDECL: "cdecl" >
    | < KW_CONTINUE: "continue" >
    | < KW_CPPDECL: "cppdecl" >
    | < KW_CVAR: "cvar" >
    | < KW_DEFAULT: "default" >
    | < KW_DYNAMIC: "dynamic" >
    | < KW_ENUMERATOR: "enumerator" >
    | < KW_EXPORT: "export" >
    | < KW_EXTERNAL: "external" >
    | < KW_FAR: "far" >
    | < KW_FAR16: "far16" >
    | < KW_FORWARD: "forward" >
    | < KW_GENERIC: "generic" >
    | < KW_HELPER: "helper" >
    | < KW_IMPLEMENTS: "implements" >
    | < KW_INDEX: "index" >
    | < KW_INTERRUPT: "interrupt" >
    | < KW_IOCHECK: "iocheck" >
    | < KW_LOCAL: "local" >
    | < KW_MESSAGE: "message" >
    | < KW_NAME: "name" >
    | < KW_NEAR: "near" >
    | < KW_NODEFAULT: "nodefault" >
    | < KW_NORETURN: "noreturn" >
    | < KW_NOSTACKFRAME: "nostackframe" >
    | < KW_OLDFPCCALL: "oldfpccall" >
    | < KW_OTHERWISE: "otherwise" >
    | < KW_OVERLOAD: "overload" >
    | < KW_OVERRIDE: "override" >
    | < KW_PASCAL: "pascal" >
    | < KW_PRIVATE: "private" >
    | < KW_PROTECTED: "protected" >
    | < KW_PUBLIC: "public" >
    | < KW_PUBLISHED: "published" >
    | < KW_READ: "read" >
    | < KW_REGISTER: "register" >
    | < KW_REINTRODUCE: "reintroduce" >
    | < KW_RESULT: "result" >
    | < KW_SAFECALL: "safecall" >
    | < KW_SAVEREGISTERS: "saveregisters" >
    | < KW_SOFTFLOAT: "softfloat" >
    | < KW_SPECIALIZE: "specialize" >
    | < KW_STATIC: "static" >
    | < KW_STDCALL: "stdcall" >
    | < KW_STORED: "stored" >
    | < KW_STRICT: "strict" >
    | < KW_UNALIGNED: "unaligned" >
    | < KW_VARARGS: "varargs" >
    | < KW_VIRTUAL: "virtual" >
    | < KW_WINAPI: "winapi" >
    | < KW_WRITE: "write" >


// Hint Directives (are Modifies too)
    | < KW_DEPRECATED: "deprecated" >
    | < KW_EXPERIMENTAL: "experimental" >
    | < KW_PLATFORM: "platform" >
    | < KW_UNIMPLEMENTED: "unimplemented" >

// Special symbols
    | < SEMI: ";" >
    
    // Simple symbols
    | < PLUS: "+" >
    | < MINUS: "-" >
    | < MULT: "*" >
    | < DIVIDE: "/" >
    | < EQUAL: "=" >
    | < LT: "<" >
    | < GT: ">" >
    | < LBRACKET: "[" >
    | < RBRACKET: "]" >
    | < DOT: "." >
    | < COMMA: "," >
    | < LPAREN: "(" >
    | < RPAREN: ")" >
    | < COLON: ":" >
    | < POINTER: "^" >
    | < AT: "@" >
    | < LBRACE: "{" >
    | < RBRACE: "}" >
    | < DOLLAR: "$" >
    | < HASH: "#" >
    | < AMPERSAND: "&" >
    | < PERCENT: "%" >

    // Compound operators and double symbols
    | < SHL_SYM: "<<" >
    | < SHR_SYM: ">>" >
    | < EXP_SYM: "**" >
    | < NE: "<>" >
    | < REVERSED_NE: "><" >
    | < LE: "<=" >
    | < GE: ">=" >
    | < ASSIGN: ":=" >
    | < PLUS_ASSIGN: "+=" >
    | < MINUS_ASSIGN: "-=" >
    | < MULT_ASSIGN: "*=" >
    | < DIV_ASSIGN: "/=" >
    
//Data types
    // Integer types
    | < BYTE: "byte" >
    | < SHORTINT: "shortint" >
    | < SMALLINT: "smallint" >
    | < WORD: "word" >
    | < INTEGER: "integer" >
    | < CARDINAL: "cardinal" >
    | < LONGINT: "longint" >
    | < LONGWORD: "longword" >
    | < INT64: "int64" >
    | < QWORD: "qword" >

    | < DOUBLE: "Double" >

    // Boolean types
    | < BOOLEAN: "boolean" >
    | < BOOLEAN16: "boolean16" >
    | < BOOLEAN32: "boolean32" >
    | < BOOLEAN64: "boolean64" >
    | < BYTEBOOL: "bytebool" >
    | < WORDBOOL: "wordbool" >
    | < LONGBool: "longbool" >
    | < QWORDBool: "qwordbool" >

    // Char types
    | < ANSICHAR: "ansichar" >
    | < WIDECHAR: "widechar" >
    
    //String data types
    | < KW_STRING: "string" >

    // Ordinal functions
    | < ORD: "ord" >
    | < INC: "inc" >
    | < DEC: "dec" >
    | < SUCC: "succ" >
    | < PRED: "pred" >

//Others

    | < COMPOUND_TYPE: "of" >
    | < ARRAY: "array" >
    | < DOUBLE_DOT: ".." >

    // Intern Tokens
    | < #LETTER: ["a"-"z","A"-"Z"] >
    | < #LETTER_HEXADECIMAL: ["a"-"f","A"-"F"] >
    | < #DIGIT: ["0"-"9"] >
    | < #OCTAL_DIGIT: ["0"-"7"] >
    | < #BINARY_DIGIT: ["0"-"1"] >
    | < #SIGN: ["+"] | ["-"] >
    | < #SINGLE_QUOTES: "''" >
    | < #CONTROL_STRING: "'" ("#" ( <DIGIT> )+ )* "'" >
    | < #REAL_HELP: ( <SIGN> )? ( <DIGIT> )+ "." ( <DIGIT> )* >


    // Strings
    | < STRING: "'" ( ~["'"] | <SINGLE_QUOTES> | <CONTROL_STRING> )* "'" >

    // Numbers
    | < NUMBER_REAL: ( <SIGN> )? ( <DIGIT> )+ "." ( <DIGIT> )+ >
    | < NUMBER_INTEGER: ( <SIGN> )? ( <DIGIT> )+ >
    | < NUMBER_HEXADECIMAL: ( <SIGN> )? "$" (<DIGIT> | <LETTER_HEXADECIMAL>)+ >
    | < NUMBER_OCTAL: ( <SIGN> )? "&" (<OCTAL_DIGIT>)+ >
    | < NUMBER_BINARY: ( <SIGN> )? "%" (<BINARY_DIGIT>)+ >
    | < NUMBER_EXPONENTIAL: ( ( <SIGN> )? ( ( <DIGIT> )+ (["e","E"]) ( <SIGN> )? ( <DIGIT> )+ ) ) | 
            ( ( <SIGN> )? ( ( <REAL_HELP> )+ (["e","E"]) ( <SIGN> )? ( <DIGIT> )+ ) ) >
    
    // Vectors and expressions with brackets
    | < VECTOR: "[" (<DIGIT>)* "]"  >

    // Identifiers
    | < ID: <LETTER> ( <LETTER> | <DIGIT> )* >
    | < ESCAPED_ID: "&" <LETTER> ( <LETTER> | <DIGIT> )* >
}

/* The regular expressions here will be skipped during lexical analysis: */
SKIP : {
    < COMMENT_MULTIPLE_LINES: ( "{" (~["}"])* "}" )+ | ( "(*" ( ~["*", ")"] )* "*)" )+ >
    | < COMMENT_SINGLE_LINE: "//" (~["\n", "\r"])* >
    | < WHITESPACE: ([" ", "\t", "\r", "\n"])+ >
}

/* If we have a substring that does not match any of the regular expressions in TOKEN or SKIP,
JavaCC will automatically throw an error. */

void Start() : {}
{
    {
        Token t;
        do {
            t = getNextToken();
            String tokenName = getTokenName(t.kind);
            System.out.println(tokenName + " " + t.image);
            gramWriter.print(tokenName + " ");
        } while (t.kind != 0); // 0 = EOF
    }
}