// This grammar must express at least the following structures of Pascal language.
/*
Arithmetic operators: +, -, *, /, %, parentheses, etc.
• Comparison operators: <,<=,>,>=,==,!=, etc.
• Logical operators: ||, &&, !
• Assignments
• Flow controls: if, if-else, while. (Not required, but allowed: for, do-while, switch, goto, break, continue)
• Function calls, which can be part of expressions
• Function declaration (It is not necessary to support nested functions or function pointers)
• Function return
• Variable type declaration
• Variable declaration, array variables (vectors)
• Access to array/vector index
• Scope: { }, begin-end, etc.
*/

// general scope of code
START -> PROGRAM USESOPT BLOCK DOT EOF
PROGRAM -> KW_PROGRAM ID SEMI 

// Uses Directive
USESOPT -> ''
USESOPT -> KW_USES ID USESOPT_TAIL
USESOPT_TAIL -> COMMA ID USESOPT_TAIL
USESOPT_TAIL -> SEMI

// blocks of code (All code goes here)
BLOCK -> VAR_DEFINITION BLOCK
BLOCK -> FUNCTION_ALL BLOCK 
BLOCK -> KW_BEGIN MAIN_BODY KW_END
MAIN_BODY -> BODY

//TODO: Const declaration
// Variable Declaration(in var scope, variables cant be initialized, only in const scope)
VAR_DEFINITION -> KW_VAR VAR_LIST
VAR_DEFINITION -> ''

// Diferent types of variable declaration
VAR_LIST -> ARRAY_DECLARATION VAR_LIST
ARRAY_DECLARATION -> ID COLON ARRAY LBRACKET DOUBLE_DOT RBRACKET COMPOUND_TYPE DATA_TYPE SEMI VAR_LIST
VAR_LIST -> ID COLON COMPOSITE_TYPE SEMI VAR_LIST
VAR_LIST -> ID SEQUENCE_VAR_LIST
SEQUENCE_VAR_LIST -> COMMA ID SEQUENCE_VAR_LIST
SEQUENCE_VAR_LIST -> ''
SEQUENCE_VAR_LIST -> COLON DATA_TYPE SEMI VAR_LIST
VAR_LIST -> VAR_DEFINITION

// Variables Types
DATA_TYPE -> SIMPLE_TYPE
DATA_TYPE -> COMPOSITE_TYPE

COMPOSITE_TYPE -> ARRAY COMPOUND_TYPE DATA_TYPE

SIMPLE_TYPE -> BYTE
SIMPLE_TYPE -> SHORTINT
SIMPLE_TYPE -> SMALLINT
SIMPLE_TYPE -> WORD
SIMPLE_TYPE -> INTEGER
SIMPLE_TYPE -> CARDINAL
SIMPLE_TYPE -> LONGINT
SIMPLE_TYPE -> LONGWORD
SIMPLE_TYPE -> INT64
SIMPLE_TYPE -> QWORD
SIMPLE_TYPE -> DOUBLE
SIMPLE_TYPE -> BOOLEAN
SIMPLE_TYPE -> BOOLEAN16
SIMPLE_TYPE -> BOOLEAN32
SIMPLE_TYPE -> BOOLEAN64
SIMPLE_TYPE -> BYTEBOOL
SIMPLE_TYPE -> WORDBOOL
SIMPLE_TYPE -> LONGBool
SIMPLE_TYPE -> QWORDBool
SIMPLE_TYPE -> ANSICHAR
SIMPLE_TYPE -> WIDECHAR

SIMPLE_TYPE -> KW_STRING
// functions declaration 
/*Tests:
KW_FUNCTION ID LPAREN ID COLON INTEGER SEMI ID COLON INTEGER SEMI ID COLON ARRAY COMPOUND_TYPE INTEGER RPAREN COLON INTEGER SEMI
KW_FUNCTION ID COLON INTEGER SEMI
KW_FUNCTION ID LPAREN RPAREN COLON INTEGER SEMI
KW_FUNCTION ID LPAREN ID COMMA ID COLON INTEGER RPAREN COLON BOOLEAN SEMI
KW_FUNCTION ID LPAREN ID COMMA ID COLON INTEGER RPAREN COLON INTEGER SEMI
*/


FUNCTION_ALL -> KW_FUNCTION ID PARAMETERS COLON DATA_TYPE SEMI FUNCTION_BODY
PARAMETERS -> LPAREN FUNC_PARAM_EXISTS RPAREN
PARAMETERS -> LPAREN RPAREN
PARAMETERS -> ''
FUNCTION_BODY -> VAR_DEFINITION FUNCTION_BODY
FUNCTION_BODY -> KW_BEGIN BODY KW_END SEMI BLOCK

FUNC_PARAM_EXISTS -> FUNC_PARAM FUNC_PARAM_ALL
FUNC_PARAM_ALL -> SEMI FUNC_PARAM FUNC_PARAM_ALL
FUNC_PARAM_ALL -> ''

// function parameters with COLON
FUNC_PARAM -> FUNC_PARAM_COLON COLON DATA_TYPE
FUNC_PARAM_COLON -> ID FUNC_PARAM_COLON_HELP
FUNC_PARAM_COLON_HELP -> ''
FUNC_PARAM_COLON_HELP -> COMMA ID FUNC_PARAM_COLON_HELP

//TODO: initialization of function parameters
//FUNC_PARAM -> FUNC_PARAM_COLON COLON DATA_TYPE INITIALIZATION
INITIALIZATION -> ASSIGN EXPRESSION

// function body (or code)
BODY -> ID INITIALIZATION SEMI BODY
BODY -> ''
//TODO: SEMI can be optional after END
//TODO: Not necessary for simplicity BODY -> FUNCTION_CALL SEMI BODY

/*Tests for expressions:
-5 * (x + foo(3)) <> 0 and a or b xor c
MINUS NUMBER_LITERAL MULT LPAREN ID PLUS ID LPAREN NUMBER_LITERAL RPAREN RPAREN REVERSED_NE NUMBER_LITERAL KW_AND ID KW_OR ID KW_XOR ID

not (a or b) and c
KW_NOT LPAREN ID KW_OR ID RPAREN KW_AND ID

a shl 2 + 4
ID SHL_SYM NUMBER_LITERAL PLUS NUMBER_LITERAL

ID DIVIDE NUMBER_LITERAL KW_MOD NUMBER_LITERAL
x / 2 mod 3
*/
//Right side of assign " := "
EXPRESSION -> LOGICAL_OPERATIONS

//logical operators(less precedence order)
LOGICAL_OPERATIONS -> LOGICAL_OPERATIONS KW_AND RELATIONAL_OPERATIONS
LOGICAL_OPERATIONS -> LOGICAL_OPERATIONS KW_OR RELATIONAL_OPERATIONS
LOGICAL_OPERATIONS -> LOGICAL_OPERATIONS KW_XOR RELATIONAL_OPERATIONS
LOGICAL_OPERATIONS -> RELATIONAL_OPERATIONS

//relational operators(normal precedence order)
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS EQUAL ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS NE ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS REVERSED_NE ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS LT ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS GT ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS LE ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> RELATIONAL_OPERATIONS GE ARITHMETIC_OPERATIONS
RELATIONAL_OPERATIONS -> ARITHMETIC_OPERATIONS

//arithmetic operators(intermediary precedence order)
ARITHMETIC_OPERATIONS -> ARITHMETIC_OPERATIONS PLUS MULTIPLICATIVE_OPERATIONS
ARITHMETIC_OPERATIONS -> ARITHMETIC_OPERATIONS MINUS MULTIPLICATIVE_OPERATIONS
ARITHMETIC_OPERATIONS -> MULTIPLICATIVE_OPERATIONS

//multiplicative operators(high precedence order)
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS MULT UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS DIVIDE UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS KW_DIV UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS KW_MOD UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS KW_SHL UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS KW_SHR UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS SHL_SYM UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS SHR_SYM UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> MULTIPLICATIVE_OPERATIONS KW_AND UNARY_OPERATIONS
MULTIPLICATIVE_OPERATIONS -> UNARY_OPERATIONS

//unary operators(Highest precedence)
UNARY_OPERATIONS -> KW_NOT UNARY_OPERATIONS
UNARY_OPERATIONS -> PLUS UNARY_OPERATIONS
UNARY_OPERATIONS -> MINUS UNARY_OPERATIONS
UNARY_OPERATIONS -> PRIMARY_OPERATIONS

//primary operations(parentheses, literals, identifiers and function calls)
PRIMARY_OPERATIONS -> LPAREN EXPRESSION RPAREN
PRIMARY_OPERATIONS -> FUNCTION_CALL
PRIMARY_OPERATIONS -> ID
PRIMARY_OPERATIONS -> NUMBER_LITERAL
PRIMARY_OPERATIONS -> VECTOR_LITERAL

//Function call: ID followed by argument list in parentheses
FUNCTION_CALL -> ID LPAREN ARGUMENT_LIST RPAREN
ARGUMENT_LIST -> EXPRESSION ARGUMENT_LIST_TAIL
ARGUMENT_LIST -> ''
ARGUMENT_LIST_TAIL -> COMMA EXPRESSION ARGUMENT_LIST_TAIL
ARGUMENT_LIST_TAIL -> ''

//Assignment
NUMBER_LITERAL -> NUMBER_BINARY
NUMBER_LITERAL -> NUMBER_EXPONENTIAL
NUMBER_LITERAL -> NUMBER_REAL
NUMBER_LITERAL -> NUMBER_INTEGER
NUMBER_LITERAL -> NUMBER_HEXADECIMAL
NUMBER_LITERAL -> NUMBER_OCTAL
NUMBER_LITERAL -> ID
VECTOR_LITERAL -> ID LBRACKET NUMBER_LITERAL RBRACKET

//Not supported in Pascal only with Overload
//EXPONENTIAL_OPERATION -> EXPONENTIAL_OPERATION EXP_SYM UNARY_OPERATIONS

